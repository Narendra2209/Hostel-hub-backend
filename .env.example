# ---------------------------------------------------------------------------
# Hostel Manager API - environment (template)
#
#   cp apps/api/.env.example apps/api/.env
#
# This is the file the API workspace itself uses. `apps/api/.env` is read both
# by Next.js (`npm run dev:api`, `npm run build:api`) and by the Prisma CLI
# (`npm run db:push`, `db:generate`, `db:studio`, `db:reset`), because those
# scripts run with apps/api as their working directory. `apps/api/.env.local`
# is read by Next only and overrides this file; the Prisma CLI ignores it.
#
# `npm run db:seed` and `npm run import:legacy` run through tsx, which loads no
# .env file at all - export the variables into your shell for those two (see
# the repo-root .env.example for a one-liner).
#
# Every variable below is declared and validated in lib/env.ts. Nothing here is
# ever sent to the browser; the client gets only the VITE_* values in
# apps/web/.env. Never commit a filled-in copy, and never put a real secret in
# this example.
# ---------------------------------------------------------------------------

# development | test | production
NODE_ENV=development

# REQUIRED. The MongoDB connection this API queries, database name included.
# It must be a mongodb:// or mongodb+srv:// URL.
#
#   local      the docker-compose replica set started by `npm run db:up`.
#              `replicaSet=rs0` is mandatory - the app writes each mutation and
#              its audit row in one multi-document transaction, and MongoDB
#              offers transactions only on a replica set. A standalone mongod
#              fails every write path with "Transactions are not supported".
#   production the Atlas SRV string. The Lambda builds it at cold start from
#              Secrets Manager (lambda-bootstrap.mjs), so it is never set as a
#              Lambda environment variable.
#              e.g. mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/hostel?retryWrites=true&w=majority
DATABASE_URL=mongodb://localhost:27017/hostel?replicaSet=rs0

# REQUIRED. HS256 key that signs session tokens. Minimum 32 characters, and
# minimum 48 when NODE_ENV=production. Generate your own:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it invalidates every token that has already been issued - everyone is
# signed out. The API refuses to start in production while this value still
# contains "dev-only-secret", so a deploy can never inherit the placeholder.
JWT_SECRET=dev-only-secret-change-me-before-deploying-anywhere

# Session token lifetime in hours (1-720). Default 12; the prod CDK stage sets 8.
SESSION_TTL_HOURS=12

# Comma-separated CORS allow-list. Never "*" - this API accepts Authorization
# headers and credentialed requests.
FRONTEND_URL=http://localhost:5173

# Largest accepted upload in megabytes (1-50). Aadhaar documents may be PDFs or
# images; photos are separately capped at 8 MB in lib/storage/gridfs.ts.
MAX_UPLOAD_MB=15

# In-process rate limiting: window length in ms, and the request budget per
# window per client (heavier endpoints charge more than one - sign-in, invite,
# password reset and the CSV exports all charge 5).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300

# Failed sign-ins before the account is locked (3-50), and the lock duration in
# minutes (1-1440). A successful sign-in clears the counter.
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCKOUT_MINUTES=15

# debug | info | warn | error
LOG_LEVEL=debug

# Optional. Region for the AWS SDK clients used by the deployment tooling.
AWS_REGION=ap-south-1

# Declared in lib/env.ts as an opt-in guard for running maintenance scripts
# against a production database; nothing consumes it yet. Leave it unset.
# ALLOW_PRODUCTION_SCRIPTS=false

# ---------------------------------------------------------------------------
# Set by CDK inside the deployed Lambda only - do not set this locally.
#
#   APP_SECRET_ARN   ARN of the one Secrets Manager secret holding DATABASE_URL
#                    (the Atlas connection string) and JWT_SECRET.
#
# lambda-bootstrap.mjs reads it at cold start and exports both values into the
# process before Next starts, so neither the connection string nor the signing
# key is ever visible to anyone with lambda:GetFunctionConfiguration.
# ---------------------------------------------------------------------------
